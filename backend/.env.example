# ═══ AI 提供方配置 ═══
# 可选值：anthropic（Claude） | openai（DeepSeek 等 OpenAI 兼容接口）
AI_PROVIDER=anthropic

# 推荐用 DeepSeek（便宜）：https://platform.deepseek.com/ 申请密钥
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com

# 若用 Claude：从 https://console.anthropic.com/ 获取
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# AI_MODEL=claude-sonnet-4-20250514

# ═══ 可插拔 embedding（概念语义对齐精排，可选） ═══
# DeepSeek/Anthropic 无 embedding API；留空则跨论文合并建议用纯字符相似度。
# 需要语义对齐时配置任意 OpenAI 兼容 /embeddings 提供方（如硅基流动）：
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_EMBEDDING_MODEL=BAAI/bge-m3
